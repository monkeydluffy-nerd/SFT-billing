import { BarChart2, ArrowRight } from "lucide-react";
import { Clock, CheckCircle2, AlertTriangle, FilePenLine } from "lucide-react";
import { formatCurrency } from "@/lib/formatters";
import { cn } from "@/lib/cn";
import { useCountUp } from "@/hooks/useCountUp";
import { useReducedMotion } from "@/hooks/useAnimations";

interface StatCardProps {
  metric: "billed" | "pending" | "paid" | "overdue" | "draft";
  label: string;
  value: number;
  changePct?: number;
  comparable?: boolean;
  isLoading?: boolean;
  subLine?: string;
  isSelected?: boolean;
  onClick?: () => void;
  sparklineData?: { x: number; y: number; value: number }[];
  isHero?: boolean;
  billed?: number;
  received?: number;
  periodLabel?: string;
  onHeroClick?: () => void;
  hasEnoughData?: boolean;
  isHeroLoading?: boolean;
  finalValue?: number;
}

const SPARKLINE_COLORS = {
  billed: "rgb(var(--color-premium))",
  pending: "rgb(var(--color-pending))",
  paid: "rgb(var(--color-success))",
  overdue: "rgb(var(--color-overdue))",
  draft: "rgb(var(--color-neutral))",
} as const;

const ICONS = {
  billed: BarChart2,
  pending: Clock,
  paid: CheckCircle2,
  overdue: AlertTriangle,
  draft: FilePenLine,
} as const;

const generateSparklinePoints = (data: { x: number; y: number; value: number }[], width = 110, height = 44, padding = 4) => {
  if (!data.length) return [];
  const min = Math.min(...data.map(d => d.value));
  const max = Math.max(...data.map(d => d.value));
  const range = max - min || 1;
  return data.map((d, i) => ({
    x: padding + (i / Math.max(data.length - 1, 1)) * (width - 2 * padding),
    y: height - padding - ((d.value - min) / range) * (height - 2 * padding),
    value: d.value,
  }));
};

const generateSparklinePathFromPoints = (points: { x: number; y: number }[]) => {
  if (!points.length) return "";
  if (points.length === 1) return `M ${points[0].x} ${points[0].y}`;
  let path = `M ${points[0].x} ${points[0].y}`;
  for (let i = 1; i < points.length; i++) {
    path += ` L ${points[i].x} ${points[i].y}`;
  }
  return path;
};

const generateFlatLinePath = (width = 110, height = 44) => {
  return `M 4 ${height / 2} L ${width - 4} ${height / 2}`;
}

function AreaSparkline({
  points,
  color,
  width = 110,
  height = 44,
  hasEnoughData = true,
}: {
  points: { x: number; y: number; value: number }[];
  color: string;
  width?: number;
  height?: number;
  hasEnoughData?: boolean;
}) {
  const points2D = generateSparklinePoints(points, width, height);
  const isFlat = !hasEnoughData || points2D.length < 2;
  const linePath = hasEnoughData && points2D.length >= 2
    ? generateSparklinePathFromPoints(points2D)
    : generateFlatLinePath(width, height);
  const areaPath = hasEnoughData && points2D.length >= 2
    ? `${linePath} L ${points2D[points2D.length - 1].x} ${height - 4} L ${points2D[0].x} ${height - 4} Z`
    : "";

  const gradientId = `sparkline-gradient-${color.replace(/[^a-zA-Z0-9]/g, "")}`;

  return (
    <svg viewBox={`0 0 ${width} ${height}`} className="w-full h-full" fill="none" aria-hidden="true" role="img" aria-label="Trend over 12 months">
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stopColor={color} stopOpacity={0.25} />
          <stop offset="100%" stopColor={color} stopOpacity={0} />
        </linearGradient>
      </defs>
      {areaPath && (
        <path d={areaPath} fill={`url(#${gradientId})`} />
      )}
      <path
        d={linePath}
        stroke={color}
        strokeWidth={1.5}
        fill="none"
        strokeLinecap="round"
        strokeLinejoin="round"
        strokeDasharray={isFlat ? "4 4" : "1000"}
        strokeDashoffset={hasEnoughData && !isFlat ? "0" : "0"}
        className={cn("draw-in", hasEnoughData && !isFlat && "animate-draw-in")}
      />
    </svg>
  );
}

export function StatCard(props: StatCardProps) {
  const {
    metric,
    label,
    value,
    changePct,
    comparable,
    isLoading = false,
    subLine,
    isSelected = false,
    onClick,
    sparklineData,
    isHero = false,
    received = 0,
    periodLabel,
    onHeroClick,
    finalValue,
  } = props;

  const _reducedMotion = useReducedMotion();
  const { value: animatedValue } = useCountUp(
    finalValue ?? value,
    _reducedMotion ? 0 : 800,
    0
  );
  const Icon = ICONS[metric];

  if (isHero) {
    const changeText = comparable && changePct !== undefined && changePct !== 0
      ? `${changePct > 0 ? "↑" : "↓"} ${Math.abs(changePct).toFixed(1)}% from previous period`
      : `${formatCurrency(received)} collected so far`;

    return (
      <button
        type="button"
        onClick={onHeroClick}
        className={cn(
          "relative isolate overflow-hidden flex flex-col rounded-lg border p-5 min-h-[162px]",
          "bg-gradient-to-br from-[rgb(19,35,29)] to-[rgb(18,41,31)] border-[rgb(156,122,60)/0.35] text-sidebar-ink",
          "shadow-card hover:shadow-float transition-shadow duration-micro cursor-pointer",
          isSelected && "ring-2 ring-success"
        )}
        aria-label="Open billed report"
        aria-pressed={isSelected}
        tabIndex={0}
      >
        <div className="relative flex flex-col flex-1 z-10">
          <div className="flex items-center justify-between gap-4">
            <p className="text-[10px] font-semibold uppercase tracking-[0.2em] text-gold shrink-0">
              {periodLabel}
            </p>
            <BarChart2 size={14} strokeWidth={1.8} className="text-gold/70" aria-hidden />
          </div>

          <p className="mt-1.5 text-[11px] font-semibold text-gold">
            BILLED
          </p>

          <p className="font-tabular mt-1 font-display text-4xl tracking-[-0.02em] text-sidebar-ink">
            {formatCurrency(animatedValue)}
          </p>

          <div className="mt-auto pt-3">
            <p className="text-[12px] text-sidebar-muted">
              {changeText}
            </p>
          </div>

          <div className="absolute right-5 bottom-5 w-[110px] h-[44px] pointer-events-none" aria-hidden="true" role="img" aria-label="Billed trend over 12 months">
            <AreaSparkline
              points={sparklineData || []}
              color="rgb(var(--color-premium))"
              hasEnoughData={sparklineData && sparklineData.length >= 2}
            />
          </div>
        </div>
      </button>
    );
  }

  return (
    <button
      type="button"
      onClick={onClick}
      className={cn(
        "relative flex flex-col rounded-lg border border-border bg-surface p-5 min-h-[162px] shadow-card",
        "hover:shadow-float transition-shadow duration-micro cursor-pointer",
        "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
        isSelected && "ring-2 ring-success",
        isLoading && "opacity-50 cursor-wait"
      )}
      aria-pressed={isSelected}
      aria-label={`${label} card`}
      tabIndex={0}
      disabled={isLoading}
    >
      <div className="flex items-center justify-between gap-4">
        <div className="flex items-center gap-3">
          <div className="flex-shrink-0 w-9 h-9 rounded-lg flex items-center justify-center bg-pending-bg text-pending">
            <Icon size={18} strokeWidth={1.8} aria-hidden />
          </div>
          <span className="text-base font-medium text-ink">{label}</span>
        </div>
        <ArrowRight size={16} strokeWidth={2} className="text-ink-faint shrink-0" aria-hidden />
      </div>

      <div className="font-tabular mt-2 text-3xl font-normal text-ink">
        {formatCurrency(animatedValue)}
      </div>

      <div className="mt-auto text-sm text-ink-muted">
        {subLine}
      </div>

      <div className="absolute right-5 bottom-5 w-[110px] h-[44px] pointer-events-none" aria-hidden="true" role="img" aria-label={`${label} trend over 12 months`}>
        <AreaSparkline
          points={sparklineData || []}
          color={SPARKLINE_COLORS[metric]}
          hasEnoughData={sparklineData && sparklineData.length >= 2}
        />
      </div>
    </button>
  );
}