import {
  LayoutGrid,
  FileText,
  Users,
  Package,
  CreditCard,
  FileBarChart,
  Settings,
  ChevronsLeft,
  ChevronsRight,
  Moon,
  Sun,
  Brain,
} from "lucide-react";
import type { LucideIcon } from "lucide-react";
import { useWorkspaceStore, type AppPage } from "@/hooks/useWorkspaceStore";
import { SurfineMark } from "@/components/shared/SurfineMark";
import { cn } from "@/lib/cn";

interface NavItem {
  page: AppPage;
  label: string;
  icon: LucideIcon;
  available: boolean;
}

const NAV_ITEMS: NavItem[] = [
  { page: "overview", label: "Overview", icon: LayoutGrid, available: true },
  { page: "invoices", label: "Invoices", icon: FileText, available: true },
  { page: "clients", label: "Clients", icon: Users, available: true },
  { page: "products", label: "Products", icon: Package, available: true },
  { page: "payments", label: "Payments", icon: CreditCard, available: true },
  { page: "reports", label: "Reports", icon: FileBarChart, available: true },
  { page: "settings", label: "Workspace Settings", icon: Settings, available: true },
];

const INTELLIGENCE_ITEM: NavItem = {
  page: "intelligence" as AppPage,
  label: "Intelligence",
  icon: Brain,
  available: true,
};

export function SidebarNav() {
  const { currentPage, navigateTo, sidebarCollapsed, toggleSidebar, theme, toggleTheme } = useWorkspaceStore();

  const intelligenceAvailable = typeof window !== "undefined" && window.location.href.includes("intelligence");

  const navItems = [
    ...NAV_ITEMS,
    ...(intelligenceAvailable ? [INTELLIGENCE_ITEM] : []),
  ];

  return (
    <aside
      className={cn(
        "print:hidden flex h-full shrink-0 flex-col border-r border-sidebar-border bg-sidebar text-sidebar-ink transition-[width] duration-panel",
        sidebarCollapsed ? "w-[68px]" : "w-64",
      )}
    >
      {/* Logo at top - larger with wordmark */}
      <div className={cn("flex flex-col items-center gap-4 px-4 pt-6 pb-6", sidebarCollapsed && "px-0")}>
        <div className="flex flex-col items-center gap-3">
          <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-sidebar-ink/10 text-premium">
            <SurfineMark className="h-10 w-10" title="Surfine Technology" />
          </div>
          {!sidebarCollapsed && (
            <div className="min-w-0 text-center leading-tight">
              <p className="text-[13px] font-semibold tracking-[0.13em] text-sidebar-ink">SURFINE TECHNOLOGY</p>
              <p className="mt-1 text-[10px] font-medium uppercase tracking-[0.18em] text-sidebar-muted">
                Forging a stronger tomorrow
              </p>
            </div>
          )}
        </div>
      </div>

      {!sidebarCollapsed && (
        <div className="px-4 pb-3 text-[10px] font-medium uppercase tracking-[0.2em] text-sidebar-muted">Workspace</div>
      )}

      <nav className="flex-1 space-y-1 px-3" aria-label="Primary">
        {navItems.map((item) => {
          const isActive =
            currentPage === item.page || (item.page === "invoices" && currentPage === "create-invoice");
          const Icon = item.icon;
          return (
            <button
              key={item.page}
              type="button"
              disabled={!item.available}
              onClick={() => item.available && navigateTo(item.page)}
              title={sidebarCollapsed ? item.label : undefined}
              aria-current={isActive ? "page" : undefined}
              className={cn(
                "group relative flex w-full items-center gap-3 rounded-lg border-l-4 border-transparent px-3 py-2.5 text-sm transition-all duration-micro",
                sidebarCollapsed && "justify-center border-l-0 px-0",
                isActive
                  ? "border-premium bg-premium/5 text-sidebar-ink font-medium"
                  : "text-sidebar-muted hover:bg-sidebar-ink/5 hover:text-sidebar-ink",
                !item.available && "cursor-not-allowed opacity-45 hover:bg-transparent hover:text-sidebar-muted",
              )}
            >
              <Icon size={18} strokeWidth={1.7} className="shrink-0" aria-hidden />
              {!sidebarCollapsed && <span className="truncate">{item.label}</span>}
              {!sidebarCollapsed && !item.available && (
                <span className="ml-auto shrink-0 text-[10px] text-sidebar-muted">Soon</span>
              )}
              {/* Active indicator sliding bar on right edge */}
              {isActive && !sidebarCollapsed && (
                <span
                  className="absolute right-0 top-0 bottom-0 w-[2px] bg-premium"
                  aria-hidden="true"
                />
              )}
            </button>
          );
        })}
      </nav>

      {/* Brand card at bottom - text ON the image with gradient overlay */}
      {!sidebarCollapsed && (
        <div className="relative p-3 border-t border-sidebar-border">
          <div className="relative h-28 sm:h-32 rounded-lg overflow-hidden bg-sidebar">
            <img
              src="/metal-forging-press.jpg"
              alt=""
              className="absolute inset-0 h-full w-full object-cover object-center"
              onError={(e) => {
                e.currentTarget.style.display = "none";
              }}
            />
            {/* Dark gradient overlay for text contrast */}
            <div className="absolute inset-0 bg-gradient-to-t from-sidebar/95 via-sidebar/60 to-transparent" aria-hidden="true" />
            {/* Thin gold line accent at bottom */}
            <div className="absolute bottom-0 left-0 right-0 h-0.5 bg-premium/30" aria-hidden="true" />
            {/* Text ON the image */}
            <div className="absolute bottom-4 left-4 right-4 text-center">
              <p className="text-[10px] font-semibold uppercase tracking-[0.13em] text-premium">Surfine Technology</p>
              <p className="mt-1 text-sm font-medium text-sidebar-ink">Precision in every detail.</p>
              <div className="mt-1.5 w-10 h-0.5 mx-auto bg-premium" aria-hidden="true" />
              <p className="mt-1.5 text-xs text-sidebar-muted">For a stronger business tomorrow.</p>
            </div>
          </div>
        </div>
      )}

      <div className={cn("flex items-center gap-1 border-t border-sidebar-border px-3 py-3", sidebarCollapsed && "flex-col")}>
        <button
          type="button"
          onClick={toggleTheme}
          title={theme === "light" ? "Switch to dark mode" : "Switch to light mode"}
          className="flex h-8 w-8 items-center justify-center rounded-lg text-sidebar-muted transition-colors duration-micro hover:bg-sidebar-ink/5 hover:text-sidebar-ink"
        >
          {theme === "light" ? <Moon size={16} strokeWidth={1.7} /> : <Sun size={16} strokeWidth={1.7} />}
        </button>
        <button
          type="button"
          onClick={toggleSidebar}
          title={sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar"}
          className="flex h-8 w-8 items-center justify-center rounded-lg text-sidebar-muted transition-colors duration-micro hover:bg-sidebar-ink/5 hover:text-sidebar-ink"
        >
          {sidebarCollapsed ? <ChevronsRight size={16} strokeWidth={1.7} /> : <ChevronsLeft size={16} strokeWidth={1.7} />}
        </button>
      </div>
    </aside>
  );
}